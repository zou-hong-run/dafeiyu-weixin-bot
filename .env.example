# 模型
DEEP_SEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 微信机器人的凭证存在 data/ilink/ 下（扫码登录后自动写入），不需要配 appId/appSecret

# 人格
# SYSTEM_PROMPT=自定义人设，留空用内置的

# 对话
HISTORY_TURNS=10
MAX_INPUT_CHARS=1000
REPLY_MAX_CHARS=900
MAX_OUTPUT_TOKENS=4096

# 连发合并：你连着发几句就合成一次理解。0 = 关闭，逐条回
MERGE_WINDOW_MS=2500

# 工具
# 同时最多几个模型调用 / 工具调用，超出的排队而不是一起打出去。
# 多用户同时聊天时这两个值是关键：调太大会撞接口限流，太小会让用户等。
LLM_CONCURRENCY=4
TOOL_CONCURRENCY=4

# 一轮对话最多调几轮工具。8 轮对「搜几条新闻 + 抓正文 + 写文件 + 发送」这种任务不够，
# 撞上限后会用已有信息强制总结（不会白跑），但复杂长任务建议用 /task 交给后台工单
MAX_TOOL_ROUNDS=16
# 单次工具调用超时（秒）
TOOL_TIMEOUT_SECONDS=60
# 高危工具（shell / 写文件 / 清记忆等）授权
# 三种情况：
#   1. 配了 ADMIN_USER_IDS → 只有名单里的 id 能用
#   2. 没配但 ALLOW_DANGEROUS=true → 都能用（仅建议单人自用）
#   3. 都没配 → 默认禁用（最小权限）
# 你的 id 在启动日志或 /diag 里能看到（形如 o9cq...@im.wechat）
# ADMIN_USER_IDS=
# ALLOW_DANGEROUS=false

# 主动推送门控（分钟）：超过这么久没说话就不主动推，
# 因为 context_token 会放旧，推了也大概率失败
PUSH_MAX_IDLE_MINUTES=30

# 后台工单
# 单个工单最多调多少轮工具
TASK_MAX_ROUNDS=20
# 验收不过时自动续跑几次，0 = 关掉
TASK_MAX_CONTINUATIONS=2
# 同时能跑几个工单
TASK_CONCURRENCY=2
# 进度汇报最短间隔（秒）和最多几条
TASK_REPORT_INTERVAL=60
TASK_MAX_REPORTS=3
# 多久没新动作就算卡住（秒），巡检会提醒
TASK_STALL_SECONDS=300

# 收到的图片 / 文件留多久（小时）
MEDIA_TTL_HOURS=24

# 闲置会话回收（小时）：多久没说话就清空短期记忆（长期事实不受影响）。0 = 不回收
SESSION_TTL_HOURS=24

# 多账号管理页面
# 默认只听 127.0.0.1，远程访问用 SSH 端口转发。
# 要直接对外监听（WEB_HOST=0.0.0.0），必须设 WEB_ACCESS_TOKEN，否则启动会被拒绝。
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8848
# WEB_ACCESS_TOKEN=
# 最多接多少个微信账号：每个账号常驻一条长轮询连接，主要吃内存
MAX_TENANTS=20

# 代码自动同步：每 N 分钟把本地改动提交推送，再把远端更新拉下来合并。0 = 关闭。
# 多实例部署同一个仓库时只能在一个实例上开，否则两边会互相冲突。
AUTO_SYNC_MINUTES=0

# 数据目录（可选）。配了就把数据放到项目外，代码目录可以随便 git reset / 重装。
# 只建议外置 DATA_DIR 和 SKILLS_DIR——downloads/logs/tmp 外置后模型读不到下载的文件。
# DATA_DIR=/var/lib/wechatbot/data
# SKILLS_DIR=/var/lib/wechatbot/skills

# 部署相关
# 密钥文件位置：默认 /etc/wechatbot/env（Linux）或 %APPDATA%/wechatbot/env（Windows），
# 项目根的 .env 只做兜底。想换位置就设这个。
# APP_ENV_FILE=

# 日志：debug / info / warn / error / silent，同时写 logs/bot-日期.log
LOG_LEVEL=info
# 打印每次工具调用的参数，排查用
TOOL_DEBUG=false

# 外部程序（可选，默认从 PATH 里找；找不到对应功能会报错，其他功能照常）
# yt-dlp 用来解析视频，ffmpeg 用来转音频和合并视频
# YTDLP_PATH=
# FFMPEG_PATH=
# B 站风控（412）时让 yt-dlp 伪装浏览器，需要额外装 curl_cffi
# YTDLP_IMPERSONATE=chrome
# B 站字幕和部分需登录的视频要 cookies，放 data/cookies.txt（Netscape 格式）
